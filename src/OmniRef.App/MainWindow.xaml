<Window x:Class="OmniRef.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OmniRef.App.Controls"
        xmlns:converters="clr-namespace:OmniRef.App.Converters"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="OmniRef"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ToolbarButton}"
                        Margin="7,3,3,3"
                        Click="New_Click"
                        ToolTip="{Binding Localization[NewWorkspace]}"
                        AutomationProperties.Name="{Binding Localization[NewWorkspace]}">
                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                      Icon="Add" />
                </Button>

                <ListBox Grid.Column="1"
                         ItemsSource="{Binding Workspaces}"
                         SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                         VerticalContentAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Margin" Value="2,4" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           VerticalAlignment="Center"
                                           MaxWidth="190"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0,5,0" />
                                <Button Style="{StaticResource ToolbarButton}"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Padding="5"
                                        Margin="1,0"
                                        Tag="{Binding}"
                                        Click="CloseTab_Click"
                                        ToolTip="{Binding DataContext.Localization[CloseTab], RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{Binding DataContext.Localization[CloseTab], RelativeSource={RelativeSource AncestorType=Window}}">
                                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                                      Width="16"
                                                      Height="16"
                                                      FontSize="16"
                                                      IconSize="Size16"
                                                      Icon="Dismiss" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="2,3,7,3">
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                  Click="AlwaysOnTop_Click"
                                  ToolTip="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.Name="{Binding Localization[AlwaysOnTop]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Pin" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Theme_Click"
                            ToolTip="{Binding Localization[Theme]}"
                            AutomationProperties.Name="{Binding Localization[Theme]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="WeatherMoon" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Language_Click"
                            ToolTip="{Binding Localization[SwitchLanguage]}"
                            AutomationProperties.Name="{Binding Localization[SwitchLanguage]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Globe" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Exit_Click"
                            ToolTip="{Binding Localization[Exit]}"
                            AutomationProperties.Name="{Binding Localization[Exit]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SignOut" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="6,3">
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                                  ToolTip="{Binding Localization[Sidebar]}"
                                  AutomationProperties.Name="{Binding Localization[Sidebar]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="PanelLeft" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding ShowCanvasGrid, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Click="ToggleGrid_Click"
                                  ToolTip="{Binding Localization[Grid]}"
                                  AutomationProperties.Name="{Binding Localization[Grid]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="GridDots" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding SnapToGrid, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Click="ToggleGridSnap_Click"
                                  ToolTip="{Binding Localization[GridSnap]}"
                                  AutomationProperties.Name="{Binding Localization[GridSnap]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="TargetArrow" />
                    </ToggleButton>
                    <Separator />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Open_Click"
                            ToolTip="{Binding Localization[OpenWorkspace]}"
                            AutomationProperties.Name="{Binding Localization[OpenWorkspace]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="FolderOpen" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Save_Click"
                            ToolTip="{Binding Localization[Save]}"
                            AutomationProperties.Name="{Binding Localization[Save]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Save" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="SaveAs_Click"
                            ToolTip="{Binding Localization[SaveAs]}"
                            AutomationProperties.Name="{Binding Localization[SaveAs]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SaveEdit" />
                    </Button>
                    <Separator />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFiles_Click"
                            ToolTip="{Binding Localization[AddFiles]}"
                            AutomationProperties.Name="{Binding Localization[AddFiles]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="DocumentAdd" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFolder_Click"
                            ToolTip="{Binding Localization[AddFolder]}"
                            AutomationProperties.Name="{Binding Localization[AddFolder]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="FolderAdd" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddText_Click"
                            ToolTip="{Binding Localization[AddText]}"
                            AutomationProperties.Name="{Binding Localization[AddText]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Text" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFrame_Click"
                            ToolTip="{Binding Localization[AddFrame]}"
                            AutomationProperties.Name="{Binding Localization[AddFrame]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SquareHint" />
                    </Button>
                    <Separator />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Undo_Click"
                            ToolTip="{Binding Localization[Undo]}"
                            AutomationProperties.Name="{Binding Localization[Undo]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ArrowUndo" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Redo_Click"
                            ToolTip="{Binding Localization[Redo]}"
                            AutomationProperties.Name="{Binding Localization[Redo]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ArrowRedo" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Paste_Click"
                            ToolTip="{Binding Localization[Paste]}"
                            AutomationProperties.Name="{Binding Localization[Paste]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ClipboardPaste" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            Click="Delete_Click"
                            ToolTip="{Binding Localization[Delete]}"
                            AutomationProperties.Name="{Binding Localization[Delete]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Delete" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Arrange_Click"
                            ToolTip="{Binding Localization[Arrange]}"
                            AutomationProperties.Name="{Binding Localization[Arrange]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="AlignLeft" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="286"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding SidebarVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBox Text="{Binding SelectedWorkspace.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Localization[SearchPlaceholder]}" />
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Localization[SearchPlaceholder]}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace.SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedWorkspace.SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedWorkspace.SearchResults}"
                             PreviewMouseLeftButtonUp="SearchResult_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SecondaryText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               MaxHeight="34"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Height="1"
                            Margin="0,8"
                            Background="{DynamicResource BorderBrush}" />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding SelectedWorkspace.SelectedItem}"
                                        Visibility="{Binding SelectedWorkspace.SelectedItem, Converter={StaticResource NullToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.Localization[Properties], RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding DataContext.Localization[Title], RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding DataContext.Localization[Tags], RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 ToolTip="{Binding DataContext.Localization[TagsHint], RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Margin="0,0,0,12" />
                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                    Margin="0,0,0,12">
                                            <TextBlock Text="{Binding DataContext.Localization[TextStyle], RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding DataContext.Localization[FontSize], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding TextFontSize, UpdateSourceTrigger=LostFocus}" />
                                            </Grid>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DataContext.Localization[TextColor], RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding TextForeground, UpdateSourceTrigger=LostFocus}"
                                                     Margin="0,0,0,8" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DataContext.Localization[CardColor], RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding TextBackground, UpdateSourceTrigger=LostFocus}"
                                                     Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <Button Style="{StaticResource ToolbarButton}"
                                                        Tag="Left"
                                                        Click="TextAlignment_Click"
                                                        ToolTip="{Binding DataContext.Localization[TextAlignLeft], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AutomationProperties.Name="{Binding DataContext.Localization[TextAlignLeft], RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                                                      Icon="TextAlignLeft" />
                                                </Button>
                                                <Button Style="{StaticResource ToolbarButton}"
                                                        Tag="Center"
                                                        Click="TextAlignment_Click"
                                                        ToolTip="{Binding DataContext.Localization[TextAlignCenter], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AutomationProperties.Name="{Binding DataContext.Localization[TextAlignCenter], RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                                                      Icon="TextAlignCenter" />
                                                </Button>
                                                <Button Style="{StaticResource ToolbarButton}"
                                                        Tag="Right"
                                                        Click="TextAlignment_Click"
                                                        ToolTip="{Binding DataContext.Localization[TextAlignRight], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AutomationProperties.Name="{Binding DataContext.Localization[TextAlignRight], RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                                                      Icon="TextAlignRight" />
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button Content="{Binding DataContext.Localization[Embed], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                    Click="Embed_Click" />
                                            <Button Content="{Binding DataContext.Localization[Export], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="Export_Click" />
                                            <Button Content="{Binding DataContext.Localization[Relink], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                    Click="Relink_Click" />
                                            <Button Content="{Binding DataContext.Localization[Reveal], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="Reveal_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="CanvasHost"
                                Content="{Binding SelectedWorkspace}"
                                Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <controls:InfiniteCanvas Workspace="{Binding}"
                                                     ShowGrid="{Binding ShowCanvasGrid, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     SnapToGrid="{Binding SnapToGrid, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     PasteRequested="Canvas_PasteRequested"
                                                     CopyRequested="Canvas_CopyRequested"
                                                     ExternalDrop="Canvas_ExternalDrop" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520"
                            Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding Localization[NoWorkspace]}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Localization[NoWorkspaceHint]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button Style="{StaticResource AccentButton}"
                            Content="{Binding Localization[CreateWorkspace]}"
                            HorizontalAlignment="Center"
                            Click="CreateWorkspace_Click" />
                </StackPanel>

                <Border VerticalAlignment="Top"
                        Margin="14"
                        Padding="12,8"
                        CornerRadius="8"
                        Background="{DynamicResource DangerBrush}"
                        Visibility="{Binding SelectedWorkspace.SaveError, Converter={StaticResource NonEmptyStringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SelectedWorkspace.SaveError}"
                                   Foreground="White"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Margin="12,0,4,0"
                                Content="{Binding Localization[Retry]}"
                                Click="RetrySave_Click" />
                        <Button Grid.Column="2"
                                Content="{Binding Localization[SaveAs]}"
                                Click="RetrySaveAs_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding SelectedWorkspace.SaveStatusText}" />
                <Button Grid.Column="1"
                        Padding="6,1"
                        Margin="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="{Binding SelectedWorkspace.ZoomPercentText}"
                        Click="ResetZoom_Click"
                        ToolTip="{Binding Localization[ZoomReset]}" />
                <Button Grid.Column="2"
                        Style="{StaticResource ToolbarButton}"
                        MinWidth="28"
                        MinHeight="24"
                        Padding="8,1"
                        Margin="2"
                        Click="Compact_Click"
                        ToolTip="{Binding Localization[Compact]}"
                        AutomationProperties.Name="{Binding Localization[Compact]}">
                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                      Width="16"
                                      Height="16"
                                      FontSize="16"
                                      IconSize="Size16"
                                      Icon="Storage" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
