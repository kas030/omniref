<Window x:Class="OmniRef.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OmniRef.App.Controls"
        xmlns:converters="clr-namespace:OmniRef.App.Converters"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:local="clr-namespace:OmniRef.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="OmniRef"
        Icon="Assets/AppIcon.ico"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        WindowStyle="None"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="0"
                                        CornerRadius="10"
                                        GlassFrameThickness="1"
                                        ResizeBorderThickness="6"
                                        UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="shell:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <shell:WindowChrome CaptionHeight="0"
                                                CornerRadius="0"
                                                GlassFrameThickness="0"
                                                ResizeBorderThickness="0"
                                                UseAeroCaptionButtons="False" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="local:MainWindow.IsCanvasOnlyMode" Value="True">
                    <Setter Property="shell:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <shell:WindowChrome CaptionHeight="0"
                                                CornerRadius="0"
                                                GlassFrameThickness="0"
                                                ResizeBorderThickness="6"
                                                UseAeroCaptionButtons="False" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="local:MainWindow.IsWindowLocked" Value="True">
                    <Setter Property="shell:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <shell:WindowChrome CaptionHeight="0"
                                                CornerRadius="0"
                                                GlassFrameThickness="0"
                                                ResizeBorderThickness="0"
                                                UseAeroCaptionButtons="False" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding WindowState, RelativeSource={RelativeSource Self}}"
                                   Value="Maximized" />
                        <Condition Binding="{Binding IsCanvasOnlyMode, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="shell:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <shell:WindowChrome CaptionHeight="0"
                                                CornerRadius="0"
                                                GlassFrameThickness="0"
                                                ResizeBorderThickness="0"
                                                UseAeroCaptionButtons="False" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="PropertySectionCard" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PropertySectionHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="2,0,0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PropertyFieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PropertyActionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCanvasOnlyMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="True">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="WindowContent">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="42" />
            <RowDefinition x:Name="ToolbarRow" Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="28" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                MouseMove="TitleBar_MouseMove"
                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                LostMouseCapture="TitleBar_LostMouseCapture">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ApplicationIconImage"
                       Grid.Column="0"
                       Width="20"
                       Height="20"
                       Margin="12,0,5,0"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       IsHitTestVisible="False"
                       AutomationProperties.Name="OmniRef" />

                <Button Grid.Column="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource ToolbarButton}"
                        Margin="2,3,3,3"
                        Click="New_Click"
                        ToolTip="{Binding Localization[NewWorkspace]}"
                        AutomationProperties.Name="{Binding Localization[NewWorkspace]}">
                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                      Icon="Add" />
                </Button>

                <Grid x:Name="WorkspaceTabsHost"
                      Grid.Column="2"
                      SizeChanged="WorkspaceTabsHost_SizeChanged">
                    <Border x:Name="WorkspaceTabsScrollLeftOverlay"
                            Panel.ZIndex="1"
                            Width="32"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding Visibility, ElementName=WorkspaceTabsScrollLeftButton}">
                        <RepeatButton x:Name="WorkspaceTabsScrollLeftButton"
                                      Style="{StaticResource ToolbarScrollButton}"
                                      Width="24"
                                      Height="34"
                                      Margin="4,0,4,2"
                                      VerticalAlignment="Bottom"
                                      Visibility="Collapsed"
                                      Click="WorkspaceTabsScrollLeft_Click"
                                      ToolTip="{Binding Localization[ScrollTabsLeft]}"
                                      AutomationProperties.Name="{Binding Localization[ScrollTabsLeft]}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 7,1 L 1,7 L 7,13"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </RepeatButton>
                    </Border>
                    <ListBox x:Name="WorkspaceTabs"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             ItemsSource="{Binding Workspaces}"
                             SelectedItem="{Binding SelectedWorkspace, Mode=OneWay}"
                             SelectionChanged="WorkspaceTabs_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VerticalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="WorkspaceTabs_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="WorkspaceTabs_PreviewMouseMove"
                             MouseLeave="WorkspaceTabs_MouseLeave">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Background" Value="{DynamicResource WorkspaceTabInactiveBrush}" />
                            <Setter Property="Width"
                                    Value="{Binding WorkspaceTabWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border Background="Transparent">
                                            <Border x:Name="Root"
                                                    Margin="0,4"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="7">
                                                <ContentPresenter />
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="local:MainWindow.IsWorkspaceTabPointerOver"
                                                     Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="{DynamicResource WorkspaceTabHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="{DynamicResource WorkspaceTabActiveBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayTitle}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0,5,0" />
                                <Button Grid.Column="1"
                                        dd:DragDrop.DragSourceIgnore="True"
                                        Style="{StaticResource ToolbarButton}"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Padding="5"
                                        Margin="1,0"
                                        Tag="{Binding}"
                                        Click="CloseTab_Click"
                                        ToolTip="{Binding DataContext.Localization[CloseTab], RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{Binding DataContext.Localization[CloseTab], RelativeSource={RelativeSource AncestorType=Window}}">
                                    <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                                      IsHitTestVisible="False"
                                                      Width="16"
                                                      Height="16"
                                                      FontSize="16"
                                                      IconSize="Size16"
                                                      Icon="Dismiss" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="WorkspaceTabsScrollRightOverlay"
                            Panel.ZIndex="1"
                            Width="32"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding Visibility, ElementName=WorkspaceTabsScrollRightButton}">
                        <RepeatButton x:Name="WorkspaceTabsScrollRightButton"
                                      Style="{StaticResource ToolbarScrollButton}"
                                      Width="24"
                                      Height="34"
                                      Margin="4,0,4,2"
                                      VerticalAlignment="Bottom"
                                      Visibility="Collapsed"
                                      Click="WorkspaceTabsScrollRight_Click"
                                      ToolTip="{Binding Localization[ScrollTabsRight]}"
                                      AutomationProperties.Name="{Binding Localization[ScrollTabsRight]}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 1,1 L 7,7 L 1,13"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </RepeatButton>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}"
                            Click="MinimizeWindow_Click"
                            ToolTip="{Binding Localization[MinimizeWindow]}"
                            AutomationProperties.Name="{Binding Localization[MinimizeWindow]}">
                        <Path Style="{StaticResource CaptionGlyph}"
                              Data="M 1,8 H 9" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}"
                            Click="MaximizeRestoreWindow_Click"
                            ToolTip="{Binding Localization[MaximizeWindow]}"
                            AutomationProperties.Name="{Binding Localization[MaximizeWindow]}">
                        <Grid Width="11" Height="11">
                            <Path Data="M 1,1 H 10 V 10 H 1 Z">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource CaptionGlyph}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 3,1 H 10 V 8 H 8 M 1,3 H 8 V 10 H 1 Z">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource CaptionGlyph}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}"
                            Click="CloseWindow_Click"
                            ToolTip="{Binding Localization[CloseWindow]}"
                            AutomationProperties.Name="{Binding Localization[CloseWindow]}">
                        <Path Style="{StaticResource CaptionGlyph}"
                              Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ToolbarBar"
                Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Border Panel.ZIndex="1"
                            Width="32"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding Visibility, ElementName=ToolbarScrollLeftButton}">
                        <RepeatButton x:Name="ToolbarScrollLeftButton"
                                      Style="{StaticResource ToolbarScrollButton}"
                                      Visibility="Collapsed"
                                      Click="ToolbarScrollLeft_Click"
                                      ToolTip="{Binding Localization[ScrollToolbarLeft]}"
                                      AutomationProperties.Name="{Binding Localization[ScrollToolbarLeft]}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 7,1 L 1,7 L 7,13"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </RepeatButton>
                    </Border>
                    <ScrollViewer x:Name="ToolbarScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  ScrollChanged="ToolbarScrollViewer_ScrollChanged">
                        <StackPanel Orientation="Horizontal" Margin="6,3">
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                                  ToolTip="{Binding Localization[Sidebar]}"
                                  AutomationProperties.Name="{Binding Localization[Sidebar]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="PanelLeft" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding ShowCanvasGrid, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Click="ToggleGrid_Click"
                                  ToolTip="{Binding Localization[Grid]}"
                                  AutomationProperties.Name="{Binding Localization[Grid]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="GridDots" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding SnapToGrid, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Click="ToggleGridSnap_Click"
                                  ToolTip="{Binding Localization[GridSnap]}"
                                  AutomationProperties.Name="{Binding Localization[GridSnap]}">
                        <Path Style="{StaticResource ToolbarMagnetIcon}" />
                    </ToggleButton>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Open_Click"
                            ToolTip="{Binding Localization[OpenWorkspace]}"
                            AutomationProperties.Name="{Binding Localization[OpenWorkspace]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="FolderOpen" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Save_Click"
                            ToolTip="{Binding Localization[Save]}"
                            AutomationProperties.Name="{Binding Localization[Save]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Save" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="SaveAs_Click"
                            ToolTip="{Binding Localization[SaveAs]}"
                            AutomationProperties.Name="{Binding Localization[SaveAs]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SaveEdit" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFiles_Click"
                            ToolTip="{Binding Localization[AddFiles]}"
                            AutomationProperties.Name="{Binding Localization[AddFiles]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="DocumentAdd" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFolder_Click"
                            ToolTip="{Binding Localization[AddFolder]}"
                            AutomationProperties.Name="{Binding Localization[AddFolder]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="FolderAdd" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddText_Click"
                            ToolTip="{Binding Localization[AddText]}"
                            AutomationProperties.Name="{Binding Localization[AddText]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Text" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="AddFrame_Click"
                            ToolTip="{Binding Localization[AddFrame]}"
                            AutomationProperties.Name="{Binding Localization[AddFrame]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SquareHint" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Undo_Click"
                            ToolTip="{Binding Localization[Undo]}"
                            AutomationProperties.Name="{Binding Localization[Undo]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ArrowUndo" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Redo_Click"
                            ToolTip="{Binding Localization[Redo]}"
                            AutomationProperties.Name="{Binding Localization[Redo]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ArrowRedo" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Paste_Click"
                            ToolTip="{Binding Localization[Paste]}"
                            AutomationProperties.Name="{Binding Localization[Paste]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="ClipboardPaste" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            Click="Delete_Click"
                            ToolTip="{Binding Localization[Delete]}"
                            AutomationProperties.Name="{Binding Localization[Delete]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Delete" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Arrange_Click"
                            IsEnabled="{Binding SelectedWorkspace.CanAlignSelection, FallbackValue=False, TargetNullValue=False}"
                            ToolTip="{Binding Localization[Arrange]}"
                            AutomationProperties.Name="{Binding Localization[Arrange]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="AlignLeft" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Layer_Click"
                            IsEnabled="{Binding SelectedWorkspace.CanMoveSelectionLayer, FallbackValue=False, TargetNullValue=False}"
                            ToolTip="{Binding Localization[Layer]}"
                            AutomationProperties.Name="{Binding Localization[Layer]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Layer" />
                    </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Panel.ZIndex="1"
                            Width="32"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding Visibility, ElementName=ToolbarScrollRightButton}">
                        <RepeatButton x:Name="ToolbarScrollRightButton"
                                      Style="{StaticResource ToolbarScrollButton}"
                                      Visibility="Collapsed"
                                      Click="ToolbarScrollRight_Click"
                                      ToolTip="{Binding Localization[ScrollToolbarRight]}"
                                      AutomationProperties.Name="{Binding Localization[ScrollToolbarRight]}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 1,1 L 7,7 L 1,13"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </RepeatButton>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="4,3,7,3">
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                  Click="AlwaysOnTop_Click"
                                  ToolTip="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.Name="{Binding Localization[AlwaysOnTop]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Pin" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="{Binding IsCanvasOnlyMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                  Click="CanvasOnlyMode_Click"
                                  ToolTip="{Binding Localization[CanvasOnlyMode]}"
                                  AutomationProperties.Name="{Binding Localization[CanvasOnlyMode]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="WindowHeaderHorizontalOff" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Theme_Click"
                            ToolTip="{Binding Localization[Theme]}"
                            AutomationProperties.Name="{Binding Localization[Theme]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarThemeIcon}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Click="Language_Click"
                            ToolTip="{Binding Localization[SwitchLanguage]}"
                            AutomationProperties.Name="{Binding Localization[SwitchLanguage]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="Globe" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            Click="Exit_Click"
                            ToolTip="{Binding Localization[Exit]}"
                            AutomationProperties.Name="{Binding Localization[Exit]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Icon="SignOut" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="CanvasArea"
              Grid.Row="2"
              Background="Transparent"
              PreviewMouseRightButtonDown="CanvasHost_PreviewMouseRightButtonDown"
              PreviewMouseMove="CanvasHost_PreviewMouseMove"
              PreviewMouseRightButtonUp="CanvasHost_PreviewMouseRightButtonUp"
              LostMouseCapture="CanvasHost_LostMouseCapture">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    Panel.ZIndex="1"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Width" Value="320" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SidebarVisible}" Value="False">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             From="320"
                                                             To="0"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0"
                                                             Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             From="0"
                                                             To="320"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Padding="32,7,42,7"
                                 Text="{Binding SelectedWorkspace.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="0"
                                   Margin="36,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Localization[SearchPlaceholder]}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWorkspace.SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedWorkspace.SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <icons:FluentIcon Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          Margin="10,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          IsHitTestVisible="False"
                                          Style="{StaticResource ToolbarIcon}"
                                          Icon="Search" />
                        <Button Grid.Column="0"
                                Width="34"
                                Height="34"
                                Margin="0,0,3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="7"
                                Style="{StaticResource ToolbarButton}"
                                Click="SearchClear_Click"
                                Visibility="{Binding SelectedWorkspace.SearchQuery, Converter={StaticResource NonEmptyStringToVisibility}}"
                                ToolTip="{Binding Localization[ClearSearch]}"
                                AutomationProperties.Name="{Binding Localization[ClearSearch]}">
                            <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                              IsHitTestVisible="False"
                                              Width="16"
                                              Height="16"
                                              FontSize="16"
                                              IconSize="Size16"
                                              Icon="Dismiss" />
                        </Button>
                        <Button Grid.Column="1"
                                Margin="4,0,0,0"
                                Style="{StaticResource ToolbarButton}"
                                Click="SearchOptions_Click"
                                ToolTip="{Binding Localization[SearchOptions]}"
                                AutomationProperties.Name="{Binding Localization[SearchOptions]}">
                            <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                              Icon="Options"
                                              RenderTransformOrigin="0.5,0.5">
                            </icons:FluentIcon>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource SidebarListBox}"
                             ItemsSource="{Binding SelectedWorkspace.SearchResults}"
                             PreviewMouseLeftButtonUp="SearchResult_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SecondaryPreviewText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Height="1"
                            Margin="0,8"
                            Background="{DynamicResource BorderBrush}" />

                    <ScrollViewer Grid.Row="3"
                                  Style="{StaticResource SidebarScrollViewer}">
                        <ContentControl Content="{Binding SelectedWorkspace.SelectedItem, FallbackValue={x:Null}}"
                                        Visibility="{Binding SelectedWorkspace.SelectedItem, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DataContext.Localization[Properties], RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                                <Grid Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DataContext.Localization[ImageItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding DataContext.Localization[FileItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding DataContext.Localization[FolderItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding DataContext.Localization[TextItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding DataContext.Localization[UrlItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsUrl, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding DataContext.Localization[FrameItem], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding IsFrame, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="36"
                                                    Height="36"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    CornerRadius="8">
                                                <icons:FluentIcon Width="18"
                                                                  Height="18"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  FontSize="18"
                                                                  Foreground="{DynamicResource AccentBrush}"
                                                                  Icon="Info" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Style="{StaticResource PropertySectionHeader}"
                                                   Text="{Binding DataContext.Localization[General], RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Border Style="{StaticResource PropertySectionCard}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                           Text="{Binding DataContext.Localization[Title], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Margin="0,0,0,12" />
                                                <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                           Text="{Binding DataContext.Localization[Tags], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}"
                                                         IsReadOnly="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         ToolTip="{Binding DataContext.Localization[TagsHint], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <StackPanel Margin="0,12,0,0"
                                                            Visibility="{Binding IsUrl, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource PropertyFieldLabel}" Text="URL" />
                                                    <TextBox Text="{Binding Url, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             MaxHeight="72"
                                                             ToolTip="{Binding Url}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}">
                                            <TextBlock Style="{StaticResource PropertySectionHeader}"
                                                       Text="{Binding DataContext.Localization[Appearance], RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Border Style="{StaticResource PropertySectionCard}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="76" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding DataContext.Localization[FontSize], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding TextFontSize, UpdateSourceTrigger=LostFocus}" />
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                               Text="{Binding DataContext.Localization[TextColor], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <TextBox Text="{Binding TextForeground, UpdateSourceTrigger=LostFocus}"
                                                             Margin="0,0,0,12" />
                                                    <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                               Text="{Binding DataContext.Localization[CardColor], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <TextBox Text="{Binding TextBackground, UpdateSourceTrigger=LostFocus}"
                                                             Margin="0,0,0,12" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource ToolbarButton}"
                                                                Tag="Left"
                                                                Click="TextAlignment_Click"
                                                                ToolTip="{Binding DataContext.Localization[TextAlignLeft], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                AutomationProperties.Name="{Binding DataContext.Localization[TextAlignLeft], RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <icons:FluentIcon Style="{StaticResource ToolbarIcon}" Icon="TextAlignLeft" />
                                                        </Button>
                                                        <Button Style="{StaticResource ToolbarButton}"
                                                                Tag="Center"
                                                                Click="TextAlignment_Click"
                                                                ToolTip="{Binding DataContext.Localization[TextAlignCenter], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                AutomationProperties.Name="{Binding DataContext.Localization[TextAlignCenter], RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <icons:FluentIcon Style="{StaticResource ToolbarIcon}" Icon="TextAlignCenter" />
                                                        </Button>
                                                        <Button Style="{StaticResource ToolbarButton}"
                                                                Tag="Right"
                                                                Click="TextAlignment_Click"
                                                                ToolTip="{Binding DataContext.Localization[TextAlignRight], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                AutomationProperties.Name="{Binding DataContext.Localization[TextAlignRight], RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <icons:FluentIcon Style="{StaticResource ToolbarIcon}" Icon="TextAlignRight" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource PropertySectionHeader}"
                                                       Text="{Binding DataContext.Localization[Storage], RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Border Style="{StaticResource PropertySectionCard}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                CornerRadius="7">
                                                            <icons:FluentIcon Width="17"
                                                                              Height="17"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              FontSize="17"
                                                                              Foreground="{DynamicResource AccentBrush}"
                                                                              Icon="Storage" />
                                                        </Border>
                                                        <Grid Grid.Column="1" Margin="8,0,0,0">
                                                            <StackPanel Visibility="{Binding IsExternalReference, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding DataContext.Localization[ExternalReference], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.Localization[ExternalReferenceDescription], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </StackPanel>
                                                            <StackPanel Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding DataContext.Localization[EmbeddedCopy], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.Localization[EmbeddedCopyDescription], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>

                                                    <Border Margin="0,0,0,12"
                                                            Padding="10"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource DangerBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <icons:FluentIcon Width="16"
                                                                              Height="16"
                                                                              VerticalAlignment="Top"
                                                                              FontSize="16"
                                                                              Foreground="{DynamicResource DangerBrush}"
                                                                              Icon="Warning" />
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource DangerBrush}"
                                                                           Text="{Binding DataContext.Localization[MissingSourceTitle], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.Localization[MissingSource], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                               Text="{Binding DataContext.Localization[FileName], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <TextBox Text="{Binding SourceFileName, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             ToolTip="{Binding SourceFileName}"
                                                             Margin="0,0,0,12" />

                                                    <StackPanel Margin="0,0,0,12"
                                                                Visibility="{Binding HasSourceSize, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                                   Text="{Binding DataContext.Localization[FileSize], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <TextBlock Text="{Binding SourceSizeText}" />
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,8"
                                                                Visibility="{Binding IsExternalReference, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource PropertyFieldLabel}"
                                                                   Text="{Binding DataContext.Localization[Path], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <TextBox Text="{Binding SourcePath, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 MaxHeight="84"
                                                                 ToolTip="{Binding SourcePath}" />
                                                    </StackPanel>

                                                    <Button Style="{StaticResource PropertyActionButton}"
                                                            Visibility="{Binding CanEmbed, Converter={StaticResource BoolToVisibility}}"
                                                            IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                            Click="Embed_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" FontSize="17" Icon="Save" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding DataContext.Localization[Embed], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PropertyActionButton}"
                                                            Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVisibility}}"
                                                            Click="Export_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" FontSize="17" Icon="SaveEdit" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding DataContext.Localization[Export], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PropertyActionButton}"
                                                            Visibility="{Binding IsExternalReference, Converter={StaticResource BoolToVisibility}}"
                                                            IsEnabled="{Binding DataContext.SelectedWorkspace.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                            Click="Relink_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" FontSize="17" Icon="FolderOpen" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding DataContext.Localization[Relink], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PropertyActionButton}"
                                                            Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibility}}"
                                                            Click="Reveal_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" FontSize="17" Icon="FolderOpen" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding DataContext.Localization[Reveal], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <ContentControl x:Name="CanvasHost"
                                Content="{Binding SelectedWorkspace}"
                                Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <controls:InfiniteCanvas Workspace="{Binding}"
                                                     ShowGrid="{Binding ShowCanvasGrid, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     SnapToGrid="{Binding SnapToGrid, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     IsCanvasLocked="{Binding IsCanvasLocked, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     PasteRequested="Canvas_PasteRequested"
                                                     CopyRequested="Canvas_CopyRequested"
                                                     ExternalDrop="Canvas_ExternalDrop" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <Grid Grid.Column="1" Panel.ZIndex="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520"
                            Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding Localization[NoWorkspace]}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Localization[NoWorkspaceHint]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button Style="{StaticResource AccentButton}"
                            Content="{Binding Localization[CreateWorkspace]}"
                            HorizontalAlignment="Center"
                            Click="CreateWorkspace_Click" />
                </StackPanel>

                <Border VerticalAlignment="Top"
                        Margin="14"
                        Padding="12,8"
                        CornerRadius="8"
                        Background="{DynamicResource DangerSurfaceBrush}"
                        Visibility="{Binding SelectedWorkspace.SaveError, Converter={StaticResource NonEmptyStringToVisibility}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SelectedWorkspace.SaveError}"
                                   Foreground="White"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ErrorBannerButton}"
                                Margin="12,0,4,0"
                                Content="{Binding Localization[Retry]}"
                                Click="RetrySave_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ErrorBannerButton}"
                                Content="{Binding Localization[SaveAs]}"
                                Click="RetrySaveAs_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="StatusBar"
                Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding SelectedWorkspace.SaveStatusText}" />
                <Button Grid.Column="1"
                        Height="24"
                        Padding="6,1"
                        Margin="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="{Binding SelectedWorkspace.ZoomPercentText}"
                        Click="ResetZoom_Click"
                        ToolTip="{Binding Localization[ZoomReset]}" />
                <Grid Grid.Column="2"
                      Height="24"
                      Margin="8,2,2,2"
                      VerticalAlignment="Center"
                      ToolTip="{Binding SelectedWorkspace.StorageToolTip}">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SelectedWorkspace.StorageSizeText}" />
                </Grid>
                <Button Grid.Column="3"
                        Style="{StaticResource ToolbarButton}"
                        MinWidth="28"
                        MinHeight="24"
                        Height="24"
                        Padding="8,1"
                        Margin="2"
                        Click="Compact_Click"
                        IsEnabled="{Binding SelectedWorkspace.CanCompact}"
                        ToolTip="{Binding SelectedWorkspace.CompactionButtonToolTip}"
                        AutomationProperties.Name="{Binding Localization[Compact]}">
                    <Grid>
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Width="16"
                                          Height="16"
                                          FontSize="16"
                                          IconSize="Size16"
                                          Icon="Storage" />
                        <Ellipse Width="6"
                                 Height="6"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,-3,0"
                                 Fill="{DynamicResource WarningBrush}"
                                 Visibility="{Binding SelectedWorkspace.IsCompactionRecommended, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Border Grid.RowSpan="4"
                Panel.ZIndex="900"
                MaxWidth="380"
                Margin="16,16,16,44"
                Padding="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding SelectedWorkspace.CompactionNotificationTitle}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedWorkspace.IsCompactionNotificationVisible}"
                                     Value="True">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            CornerRadius="8">
                        <icons:FluentIcon Width="18"
                                          Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource AccentBrush}"
                                          IconSize="Size20"
                                          Icon="Storage" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedWorkspace.CompactionNotificationTitle}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Style="{StaticResource ToolbarButton}"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Margin="8,-4,-4,0"
                            Padding="5"
                            VerticalAlignment="Top"
                            Click="CompactionNotificationClose_Click"
                            ToolTip="{Binding Localization[CloseNotification]}"
                            AutomationProperties.Name="{Binding Localization[CloseNotification]}">
                        <icons:FluentIcon Style="{StaticResource ToolbarIcon}"
                                          Width="16"
                                          Height="16"
                                          FontSize="16"
                                          IconSize="Size16"
                                          Icon="Dismiss" />
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="44,10,4,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LineHeight="20"
                           Text="{Binding SelectedWorkspace.CompactionNotificationMessage}"
                           TextWrapping="Wrap" />
                <ProgressBar Grid.Row="2"
                             Style="{StaticResource FluentIndeterminateProgressBar}"
                             Margin="44,14,4,0"
                             Visibility="{Binding SelectedWorkspace.IsCompacting, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Image x:Name="ThemeTransitionOverlay"
               Grid.RowSpan="4"
               Panel.ZIndex="1000"
               IsHitTestVisible="False"
               Opacity="0"
               SnapsToDevicePixels="True"
               Stretch="Fill" />
        </Grid>
    </Border>
</Window>
