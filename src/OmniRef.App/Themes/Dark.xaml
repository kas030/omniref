<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FF202020</Color>
    <Color x:Key="SurfaceColor">#FF2C2C2C</Color>
    <Color x:Key="SurfaceRaisedColor">#FF323232</Color>
    <Color x:Key="ControlFillColor">#FF383838</Color>
    <Color x:Key="ControlFillHoverColor">#FF3E3E3E</Color>
    <Color x:Key="ControlFillPressedColor">#FF333333</Color>
    <Color x:Key="SubtleFillHoverColor">#12FFFFFF</Color>
    <Color x:Key="SubtleFillPressedColor">#1CFFFFFF</Color>
    <Color x:Key="SelectionFillColor">#248391FF</Color>
    <Color x:Key="WorkspaceTabInactiveColor">#00FFFFFF</Color>
    <Color x:Key="WorkspaceTabHoverColor">#12FFFFFF</Color>
    <Color x:Key="WorkspaceTabActiveColor">#FF333333</Color>
    <Color x:Key="CanvasBackgroundColor">#FF181818</Color>
    <Color x:Key="CanvasGridColor">#FF555555</Color>
    <Color x:Key="BorderColor">#FF3D3D3D</Color>
    <Color x:Key="BorderStrongColor">#FF5A5A5A</Color>
    <Color x:Key="CardBackgroundColor">#FF2B2B2B</Color>
    <Color x:Key="CardTextBackgroundColor">#FF303030</Color>
    <Color x:Key="CardBorderColor">#FF454545</Color>
    <Color x:Key="CardHoverBorderColor">#FF9AA5FF</Color>
    <Color x:Key="CardIconSurfaceColor">#FF383838</Color>
    <Color x:Key="CardFrameFillColor">#2B8391FF</Color>
    <Color x:Key="CardFrameBorderColor">#B08391FF</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFC7C7C7</Color>
    <Color x:Key="AccentColor">#FF8391FF</Color>
    <Color x:Key="AccentHoverColor">#FF9AA5FF</Color>
    <Color x:Key="WarningColor">#FFFFC85C</Color>
    <Color x:Key="DangerColor">#FFFF6B76</Color>
    <Color x:Key="DangerSurfaceColor">#FF9F2F3C</Color>
    <Color x:Key="ScrollBarThumbColor">#FF606060</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF818181</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{StaticResource SubtleFillHoverColor}" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{StaticResource SubtleFillPressedColor}" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="{StaticResource SelectionFillColor}" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="WorkspaceTabInactiveBrush" Color="{StaticResource WorkspaceTabInactiveColor}" />
    <SolidColorBrush x:Key="WorkspaceTabHoverBrush" Color="{StaticResource WorkspaceTabHoverColor}" />
    <SolidColorBrush x:Key="WorkspaceTabActiveBrush" Color="{StaticResource WorkspaceTabActiveColor}" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
    <SolidColorBrush x:Key="CanvasGridBrush" Color="{StaticResource CanvasGridColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardTextBackgroundBrush" Color="{StaticResource CardTextBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}" />
    <SolidColorBrush x:Key="CardIconSurfaceBrush" Color="{StaticResource CardIconSurfaceColor}" />
    <SolidColorBrush x:Key="CardFrameFillBrush" Color="{StaticResource CardFrameFillColor}" />
    <SolidColorBrush x:Key="CardFrameBorderBrush" Color="{StaticResource CardFrameBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
    <DropShadowEffect x:Key="FloatingToolbarShadowEffect"
                      BlurRadius="20"
                      Direction="270"
                      ShadowDepth="3"
                      Color="#FF000000"
                      Opacity="0.48" />
</ResourceDictionary>
