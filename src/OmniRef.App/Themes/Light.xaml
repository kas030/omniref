<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFF5F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFF0F2F5</Color>
    <Color x:Key="WorkspaceTabInactiveColor">#FFF7F8FA</Color>
    <Color x:Key="WorkspaceTabHoverColor">#FFE9EDF3</Color>
    <Color x:Key="WorkspaceTabActiveColor">#FFE1E6EE</Color>
    <Color x:Key="CanvasBackgroundColor">#FFE9EBEF</Color>
    <Color x:Key="CanvasGridColor">#FFAAB3C3</Color>
    <Color x:Key="BorderColor">#FFD8DCE3</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CardTextBackgroundColor">#FFF8F9FB</Color>
    <Color x:Key="CardBorderColor">#FFD6DBE4</Color>
    <Color x:Key="CardHoverBorderColor">#FFB8C2D2</Color>
    <Color x:Key="CardIconSurfaceColor">#FFEFF2F7</Color>
    <Color x:Key="CardFrameFillColor">#1A5363E8</Color>
    <Color x:Key="CardFrameBorderColor">#805363E8</Color>
    <Color x:Key="TextPrimaryColor">#FF1D2026</Color>
    <Color x:Key="TextSecondaryColor">#FF646C79</Color>
    <Color x:Key="AccentColor">#FF5363E8</Color>
    <Color x:Key="AccentHoverColor">#FF4051DB</Color>
    <Color x:Key="DangerColor">#FFD83A4A</Color>
    <Color x:Key="DangerSurfaceColor">#FFD83A4A</Color>
    <Color x:Key="ScrollBarThumbColor">#FFC8CDD6</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FFAEB5C1</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="WorkspaceTabInactiveBrush" Color="{StaticResource WorkspaceTabInactiveColor}" />
    <SolidColorBrush x:Key="WorkspaceTabHoverBrush" Color="{StaticResource WorkspaceTabHoverColor}" />
    <SolidColorBrush x:Key="WorkspaceTabActiveBrush" Color="{StaticResource WorkspaceTabActiveColor}" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
    <SolidColorBrush x:Key="CanvasGridBrush" Color="{StaticResource CanvasGridColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardTextBackgroundBrush" Color="{StaticResource CardTextBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}" />
    <SolidColorBrush x:Key="CardIconSurfaceBrush" Color="{StaticResource CardIconSurfaceColor}" />
    <SolidColorBrush x:Key="CardFrameFillBrush" Color="{StaticResource CardFrameFillColor}" />
    <SolidColorBrush x:Key="CardFrameBorderBrush" Color="{StaticResource CardFrameBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
</ResourceDictionary>
