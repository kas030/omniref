<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFF9F9F9</Color>
    <Color x:Key="ControlFillColor">#FFFFFFFF</Color>
    <Color x:Key="ControlFillHoverColor">#FFF9F9F9</Color>
    <Color x:Key="ControlFillPressedColor">#FFF0F0F0</Color>
    <Color x:Key="SubtleFillHoverColor">#0F000000</Color>
    <Color x:Key="SubtleFillPressedColor">#17000000</Color>
    <Color x:Key="SelectionFillColor">#145363E8</Color>
    <Color x:Key="WorkspaceTabInactiveColor">#00FFFFFF</Color>
    <Color x:Key="WorkspaceTabHoverColor">#0F000000</Color>
    <Color x:Key="WorkspaceTabActiveColor">#FFFFFFFF</Color>
    <Color x:Key="CanvasBackgroundColor">#FFEAEAEA</Color>
    <Color x:Key="CanvasGridColor">#FFB5B5B5</Color>
    <Color x:Key="BorderColor">#FFE5E5E5</Color>
    <Color x:Key="BorderStrongColor">#FFC7C7C7</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CardTextBackgroundColor">#FFF7F7F7</Color>
    <Color x:Key="CardBorderColor">#FFE1E1E1</Color>
    <Color x:Key="CardHoverBorderColor">#FF9B9B9B</Color>
    <Color x:Key="CardIconSurfaceColor">#FFF3F3F3</Color>
    <Color x:Key="CardFrameFillColor">#1A5363E8</Color>
    <Color x:Key="CardFrameBorderColor">#805363E8</Color>
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#FF616161</Color>
    <Color x:Key="AccentColor">#FF5363E8</Color>
    <Color x:Key="AccentHoverColor">#FF4051DB</Color>
    <Color x:Key="WarningColor">#FFB36B00</Color>
    <Color x:Key="DangerColor">#FFD83A4A</Color>
    <Color x:Key="DangerSurfaceColor">#FFD83A4A</Color>
    <Color x:Key="ScrollBarThumbColor">#FFB8B8B8</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF8F8F8F</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{StaticResource SubtleFillHoverColor}" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{StaticResource SubtleFillPressedColor}" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="{StaticResource SelectionFillColor}" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="WorkspaceTabInactiveBrush" Color="{StaticResource WorkspaceTabInactiveColor}" />
    <SolidColorBrush x:Key="WorkspaceTabHoverBrush" Color="{StaticResource WorkspaceTabHoverColor}" />
    <SolidColorBrush x:Key="WorkspaceTabActiveBrush" Color="{StaticResource WorkspaceTabActiveColor}" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
    <SolidColorBrush x:Key="CanvasGridBrush" Color="{StaticResource CanvasGridColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardTextBackgroundBrush" Color="{StaticResource CardTextBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}" />
    <SolidColorBrush x:Key="CardIconSurfaceBrush" Color="{StaticResource CardIconSurfaceColor}" />
    <SolidColorBrush x:Key="CardFrameFillBrush" Color="{StaticResource CardFrameFillColor}" />
    <SolidColorBrush x:Key="CardFrameBorderBrush" Color="{StaticResource CardFrameBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
    <DropShadowEffect x:Key="FloatingToolbarShadowEffect"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="3"
                      Color="#FF667085"
                      Opacity="0.24" />
</ResourceDictionary>
