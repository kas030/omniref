<Window x:Class="OmniRef.App.Dialogs.ThemedDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OmniRef"
        Icon="../Assets/AppIcon.ico"
        Width="520"
        MinWidth="420"
        MaxWidth="620"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="DialogWindow_SourceInitialized"
        SizeChanged="DialogWindow_SizeChanged"
        DpiChanged="DialogWindow_DpiChanged"
        PreviewKeyDown="DialogWindow_PreviewKeyDown">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="0"
                                        CornerRadius="12"
                                        GlassFrameThickness="1"
                                        ResizeBorderThickness="0"
                                        UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Width="18"
                           Height="18"
                           Margin="14,0,8,0"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           Source="../Assets/AppIcon.ico"
                           AutomationProperties.Name="OmniRef" />
                    <TextBlock x:Name="DialogTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Style="{StaticResource CaptionCloseButton}"
                            Click="CloseButton_Click">
                        <Path Style="{StaticResource CaptionGlyph}"
                              Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="23">
                    <Grid>
                        <icons:FluentIcon x:Name="InformationIcon"
                                          Width="22"
                                          Height="22"
                                          FontSize="22"
                                          IconSize="Size20"
                                          Icon="Info"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Visibility="Collapsed" />
                        <icons:FluentIcon x:Name="WarningIcon"
                                          Width="22"
                                          Height="22"
                                          FontSize="22"
                                          IconSize="Size20"
                                          Icon="Warning"
                                          Foreground="{DynamicResource WarningBrush}"
                                          Visibility="Collapsed" />
                        <icons:FluentIcon x:Name="ErrorIcon"
                                          Width="22"
                                          Height="22"
                                          FontSize="22"
                                          IconSize="Size20"
                                          Icon="ErrorCircle"
                                          Foreground="{DynamicResource DangerBrush}"
                                          Visibility="Collapsed" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2"
                              MaxHeight="320"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              Focusable="False"
                              IsTabStop="False"
                              FocusVisualStyle="{x:Null}">
                    <TextBlock x:Name="DialogMessageText"
                               FontSize="13"
                               LineHeight="22"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Focusable="False"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12,18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton"
                            MinWidth="76"
                            Content="No"
                            Click="DialogButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="YesButton"
                            MinWidth="76"
                            Style="{StaticResource AccentButton}"
                            FocusVisualStyle="{x:Null}"
                            Content="Yes"
                            Click="DialogButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="OkButton"
                            MinWidth="76"
                            Style="{StaticResource AccentButton}"
                            FocusVisualStyle="{x:Null}"
                            Content="OK"
                            Click="DialogButton_Click"
                            Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
